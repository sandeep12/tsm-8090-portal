{
  "name": "tsm-portal-server",
  "version": "0.1.0",
  "private": true,
  "description": "Task Management API server — persistence layer (WO-1)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "smoke:wo1": "tsx scripts/smoke-wo1.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true,
    "esbuild@0.28.2": true
  }
}
